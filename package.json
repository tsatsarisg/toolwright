{
	"name": "toolwright",
	"version": "1.0.0",
	"description": "A terminal coding agent with OpenAI and local-model support, workspace tools, approvals, and durable sessions.",
	"license": "UNLICENSED",
	"private": true,
	"repository": {
		"type": "git",
		"url": "git+https://github.com/tsatsarisg/toolwright.git"
	},
	"keywords": [
		"ai-agent",
		"cli",
		"terminal",
		"llm",
		"vercel-ai-sdk"
	],
	"type": "module",
	"engines": {
		"node": ">=22.13.0"
	},
	"bin": {
		"toolwright": "./dist/cli.js"
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"dev": "tsx watch src/cli.ts",
		"start": "tsx src/cli.ts",
		"test": "node --import tsx --test \"src/**/*.test.ts\" \"evals/**/*.test.ts\"",
		"typecheck": "tsc -p tsconfig.json --noEmit",
		"lint": "biome check .",
		"eval": "pnpm eval:coding",
		"eval:file-tools": "node --import tsx evals/file-tools.eval.ts",
		"eval:shell-tools": "node --import tsx evals/shell-tools.eval.ts",
		"eval:agent": "node --import tsx evals/agent-multiturn.eval.ts",
		"eval:coding": "node --import tsx evals/coding.eval.ts"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.14",
		"@types/node": "26.6.2",
		"@types/react": "19.3.0",
		"tsx": "4.23.15",
		"typescript": "7.0.2"
	},
	"dependencies": {
		"@ai-sdk/openai": "4.0.75",
		"@ai-sdk/openai-compatible": "3.0.55",
		"@ai-sdk/otel": "1.0.114",
		"@ai-sdk/provider": "4.0.18",
		"@ai-sdk/provider-utils": "5.0.47",
		"@lmnr-ai/lmnr": "0.8.49",
		"ai": "7.0.114",
		"ink": "7.1.1",
		"ink-spinner": "5.0.0",
		"react": "19.3.0",
		"zod": "4.6.5"
	},
	"packageManager": "pnpm@12.8.1+sha512.f64ba907507f5ceafe06c8d38e6052d0179444580ec1279ddd5bfc11cb48aa8a2644b66598e07e761da84872a9fc57d5f902b87fa49d024198d558612aabbe45"
}
