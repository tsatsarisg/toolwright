{
	"name": "toolwright",
	"version": "1.0.0",
	"description": "A general-purpose, terminal-based AI agent built from first principles in TypeScript — a custom tool-calling loop on the Vercel AI SDK with an Ink terminal UI.",
	"license": "UNLICENSED",
	"private": true,
	"repository": {
		"type": "git",
		"url": "git+https://github.com/tsatsarisg/toolwright.git"
	},
	"keywords": [
		"ai-agent",
		"cli",
		"terminal",
		"llm",
		"vercel-ai-sdk"
	],
	"type": "module",
	"engines": {
		"node": ">=20"
	},
	"bin": {
		"toolwright": "./dist/cli.js"
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"dev": "tsx watch --env-file=.env src/cli.ts",
		"start": "tsx --env-file=.env src/cli.ts",
		"test": "node --import tsx --test \"src/**/*.test.ts\" \"evals/**/*.test.ts\"",
		"typecheck": "tsc -p tsconfig.json --noEmit",
		"lint": "biome check .",
		"eval": "npx lmnr eval",
		"eval:file-tools": "npx lmnr eval evals/file-tools.eval.ts",
		"eval:shell-tools": "npx lmnr eval evals/shell-tools.eval.ts",
		"eval:agent": "npx lmnr eval evals/agent-multiturn.eval.ts"
	},
	"devDependencies": {
		"@biomejs/biome": "2.3.7",
		"@types/node": "24.13.2",
		"@types/react": "19.2.17",
		"tsx": "4.23.0",
		"typescript": "5.9.3"
	},
	"dependencies": {
		"@ai-sdk/openai": "2.0.110",
		"@lmnr-ai/lmnr": "0.8.36",
		"ai": "5.0.210",
		"ink": "6.8.0",
		"ink-spinner": "5.0.0",
		"react": "19.2.7",
		"zod": "4.4.3"
	},
	"packageManager": "pnpm@11.19.0+sha512.7881f3ed590d472c4a955e2b88b2121791116066dcc88cbca3849ec9b60f1bbaa6d2ccb221fa91da4e1c65bef2bcbe379365aea7ac539c7bf86dedc3a1b22dce"
}
