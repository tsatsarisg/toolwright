{
	"name": "toolwright",
	"version": "1.0.0",
	"description": "A general-purpose, terminal-based AI agent built from first principles in TypeScript — a custom tool-calling loop on the Vercel AI SDK with an Ink terminal UI.",
	"license": "UNLICENSED",
	"private": true,
	"repository": {
		"type": "git",
		"url": "git+https://github.com/tsatsarisg/toolwright.git"
	},
	"keywords": [
		"ai-agent",
		"cli",
		"terminal",
		"llm",
		"vercel-ai-sdk"
	],
	"type": "module",
	"engines": {
		"node": ">=20"
	},
	"bin": {
		"toolwright": "./dist/cli.js"
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"dev": "tsx watch --env-file=.env src/cli.ts",
		"start": "tsx --env-file=.env src/cli.ts",
		"test": "node --import tsx --test \"src/**/*.test.ts\" \"evals/**/*.test.ts\"",
		"typecheck": "tsc -p tsconfig.json --noEmit",
		"lint": "biome check .",
		"eval": "npx lmnr eval",
		"eval:file-tools": "npx lmnr eval evals/file-tools.eval.ts",
		"eval:shell-tools": "npx lmnr eval evals/shell-tools.eval.ts",
		"eval:agent": "npx lmnr eval evals/agent-multiturn.eval.ts"
	},
	"devDependencies": {
		"@biomejs/biome": "2.3.7",
		"@types/node": "^24.10.1",
		"@types/react": "^19.2.7",
		"tsx": "^4.21.0",
		"typescript": "^5.9.3"
	},
	"dependencies": {
		"@ai-sdk/openai": "^2.0.72",
		"@lmnr-ai/lmnr": "0.8.36",
		"ai": "^5.0.102",
		"ink": "^6.5.1",
		"ink-spinner": "^5.0.0",
		"react": "^19.2.0",
		"zod": "^4.1.13"
	},
	"packageManager": "pnpm@11.9.0+sha512.bd682d5d03fe525ef7c9fd6780c6884d1e756ac4c9c9fe00c538782824310dcf90e3ddc4f53835f06dfaebd5085e41855e0bcbb3b60de2ac5bbab89e5036f03b"
}
